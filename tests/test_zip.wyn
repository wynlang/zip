// Exercises the shipped lib in src/zip.wyn via the tests/zip.wyn symlink.
import zip

test "is archive yes" { assert(zip.zip_is_archive("data.zip")) }
test "is archive no" { assert(not zip.zip_is_archive("data.tar")) }
test "entry count estimate" { assert_eq(zip.zip_entry_count_estimate(4096), 4) }
test "entry count zero" { assert_eq(zip.zip_entry_count_estimate(0), 0) }
test "compression ratio" { assert_eq(zip.zip_compression_ratio(1000, 250), 25) }
test "compression ratio zero guard" { assert_eq(zip.zip_compression_ratio(0, 5), 0) }
test "human size bytes" { assert_eq(zip.zip_human_size(512), "512 B") }
test "human size kb" { assert_eq(zip.zip_human_size(2048), "2.0 KB") }
