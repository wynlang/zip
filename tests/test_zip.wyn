fn zip_is_archive(path: string) -> bool {
    return path.ends_with(".zip")
}

fn zip_compression_ratio(original: int, compressed: int) -> int {
    if original == 0 { return 0 }
    return (compressed * 100) / original
}

fn zip_entry_count_estimate(file_size: int) -> int {
    if file_size <= 0 { return 0 }
    return file_size / 1024
}

fn main() -> int {
    if zip_is_archive("test.zip") { println("zip detect: pass") }
    if !zip_is_archive("test.tar") { println("non-zip: pass") }
    assert_eq(zip_compression_ratio(1000, 300), 30)
    assert_eq(zip_compression_ratio(0, 0), 0)
    assert_eq(zip_entry_count_estimate(10240), 10)
    
    println("zip: 5 tests passed")
    return 0
}
