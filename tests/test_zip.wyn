test "magic len" {
    // ZIP magic bytes: PK\x03\x04
    var magic = "PK"
    assert_eq(magic.len(), 2)
}

test "zip magic" {
    // ZIP magic bytes: PK\x03\x04
    var magic = "PK"
    assert_eq(magic, "PK")
}

test "zip ext" {
    // ZIP magic bytes: PK\x03\x04
    var magic = "PK"
    // File extension
    assert("archive.zip".ends_with(".zip"))
}
